rules_version = '2';

// OMIX Firestore security rules (Blaze).
//
// Authorization model:
//   • signedIn()      - any authenticated user.
//   • isOwnerEmail()  - the 5 hardcoded business-owner e-mails (always staff).
//   • isStaff()       - owner e-mail OR the server-verified `staff` custom claim
//                       (set by the setStaffClaim Cloud Function when an owner
//                       assigns an instructor/manager role). This is what makes
//                       real per-role authorization possible.
//
// Hardening enforced here:
//   • a member can NEVER self-approve or self-promote: role / approvalStatus /
//     membershipActive / memberNo / trainerNotes / coaching / hasPass / email
//     are immutable on a self-update; only staff may change them.
//   • the admin role is console-only (no client may grant/hold it but owners).
//   • sessions, class types, services, payments, locations, lesson plans, task
//     reminders, announcements and events are STAFF-WRITE ONLY.
//   • a member may create only their own booking.
//   • audit log append-only; OAuth tokens client-invisible; unknown paths denied.
//
// NOTE (reads): read scoping (members should not read others' health forms /
// payments) is handled in a follow-up together with the client data-loading
// refactor; until then reads remain signed-in to avoid breaking the member
// mirror listeners.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // The business owners - only these verified emails are staff-by-identity and
    // may hold/grant the admin role (kept in sync with firestore.ts OWNER_EMAILS).
    function isOwnerEmail() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'office@omixfit.com',
          'omer@omixfit.com',
          'omerido20@gmail.com',
          'guy.lifshitz98@gmail.com',
          'help@omixfit.com'
        ];
    }

    // Server-verified staff: the `staff` custom claim (set on role assignment) or
    // an owner e-mail. Management writes are gated on this.
    function isStaff() {
      return signedIn() && (request.auth.token.staff == true || isOwnerEmail());
    }

    // A client may never create or set the admin role…
    function notSettingAdmin() {
      return !('role' in request.resource.data) || request.resource.data.role != 'admin';
    }
    // …nor modify an existing admin account (unless an owner).
    function notEditingAdmin() {
      return resource == null || resource.data.role != 'admin';
    }
    // Privileged user fields a member may not change on their own profile.
    function privilegedUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role', 'approvalStatus', 'membershipActive', 'memberNo',
        'trainerNotes', 'coaching', 'hasPass', 'email',
        'medicalStatus', 'healthDeclaredAt'
      ]);
    }
    // A self-signup doc must start as a plain pending member.
    function selfSignupShape() {
      return request.resource.data.role == 'member'
        && request.resource.data.approvalStatus == 'pending'
        && request.resource.data.membershipActive == false;
    }

    match /users/{uid} {
      allow read: if signedIn();
      // Self-signup creates a pending member; owners bootstrap their admin doc;
      // staff may create any user.
      allow create: if signedIn()
        && (notSettingAdmin() || isOwnerEmail())
        && (isStaff() || (request.auth.uid == uid && selfSignupShape()));
      // Staff (or an owner) may edit anyone; a member may edit ONLY their own doc
      // and NOT any privileged field - this is what blocks self-approval.
      allow update: if signedIn()
        && (notSettingAdmin() || isOwnerEmail())
        && (notEditingAdmin() || isOwnerEmail())
        && (isStaff() || (request.auth.uid == uid && privilegedUnchanged()));
      allow delete: if false; // deletion goes through the deleteMember function

      // Sensitive profile: health declaration + PII. Only the owner (self) and
      // staff may read/write it - THIS is what hides members' health forms/ID
      // numbers from other members.
      match /private/{doc} {
        allow read, write: if signedIn() && (request.auth.uid == uid || isStaff());
      }
    }

    // collectionGroup('private') - lets staff stream every private profile in one
    // query for the roster/member views. Non-staff queries are denied.
    match /{path=**}/private/{doc} {
      allow read: if isStaff();
    }

    // ---- management data: staff-write only, signed-in read -------------------
    match /sessions/{id}      { allow read: if signedIn(); allow write: if isStaff(); }
    match /classTypes/{id}    { allow read: if signedIn(); allow write: if isStaff(); }
    match /locations/{id}     { allow read: if signedIn(); allow write: if isStaff(); }
    match /services/{id}      { allow read: if signedIn(); allow write: if isStaff(); }
    match /payments/{id}      { allow read: if signedIn(); allow write: if isStaff(); }
    match /lessonPlans/{id}   { allow read: if signedIn(); allow write: if isStaff(); }
    match /taskReminders/{id} { allow read: if signedIn(); allow write: if isStaff(); }
    match /announcements/{id} { allow read: if signedIn(); allow write: if isStaff(); }

    // Bookings: a member may create only their own; updates/deletes stay signed-in
    // because canceling promotes another member's waitlisted booking client-side.
    match /bookings/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && (isStaff() || request.resource.data.userId == request.auth.uid);
      allow update, delete: if signedIn();
    }

    // Special events / retreats - PUBLIC read (marketing + signup page); staff write.
    match /events/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    // Event registrations - PUBLIC create (non-members sign up), staff manage.
    match /eventSignups/{id} {
      allow read: if signedIn();
      allow update, delete: if isStaff();
      allow create: if request.resource.data.keys().hasAll(['eventId', 'name', 'phone', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.eventId is string;
    }
    // Landing leads - PUBLIC create ("just sign up"), staff manage.
    match /leads/{id} {
      allow read: if signedIn();
      allow update, delete: if isStaff();
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30;
    }

    // Audit log - append-only: created + read, never changed or removed.
    match /audit/{id} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }

    // Private owner-only billing tracker - only the verified business owners.
    match /meta/subscriptions {
      allow read, write: if isOwnerEmail();
    }
    // Google Calendar OAuth refresh token - Cloud Functions only.
    match /meta/calendar {
      allow read, write: if false;
    }
    // Per-member personal-calendar OAuth refresh tokens - Cloud Functions only.
    match /calTokens/{uid} {
      allow read, write: if false;
    }

    // Seed marker, member counter, facility settings. Kept signed-in-writable
    // because sign-up increments meta/counters (memberSeq) before the user is
    // staff. (subscriptions + calendar are matched above.)
    match /meta/{doc} {
      allow read, create, update: if signedIn() && doc != "subscriptions" && doc != "calendar";
      allow delete: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} { allow read, write: if false; }
  }
}
