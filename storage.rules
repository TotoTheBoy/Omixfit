rules_version = '2';

// Omix Cloud Storage rules. Only medical certificates are stored, under a
// per-user folder. A member may upload their OWN certificate (image/PDF, <10MB);
// only the owner and staff may read it. Everything else is denied.
service firebase.storage {
  match /b/{bucket}/o {
    match /medicalCerts/{uid}/{file=**} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || request.auth.token.staff == true);
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
